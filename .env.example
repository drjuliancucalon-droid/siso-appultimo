# ═══════════════════════════════════════════════════════════
# SISO OcupaSalud Pro — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ── Backend ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Supabase (backend only — NEVER in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-string
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# AI Providers (backend only — keys NEVER go to the browser)
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173
